# ==========================================
# 1. Python 相关
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
.venv/
venv/
ENV/

# 环境变量文件 (防止API密钥泄露！)
.env
.env.local

# ==========================================
# 2. Node.js / Electron 相关
# ==========================================
# 极其重要：忽略巨大的依赖包
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron 打包产物
dist/
out/
build/

# ==========================================
# 3. 人工智能 / YOLO 相关
# ==========================================
# 忽略 YOLO 训练过程生成的庞大日志和中间权重
runs/
datasets/
# 忽略训练出来的模型权重（如果是几百兆以上，不要传GitHub）
*.pt
*.pth
*.onnx
*.weights

# 忽略你之前测试生成的临时识别图片
result_*.jpg

# ==========================================
# 4. 系统 / IDE 文件
# ==========================================
# PyCharm / VS Code
.idea/
.vscode/
*.swp
*.swo

# Windows / Mac 系统文件
.DS_Store
Thumbs.db
Desktop.ini